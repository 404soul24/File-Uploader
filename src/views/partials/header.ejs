<header class="border-b border-zinc-200 bg-white/80 dark:border-zinc-800 dark:bg-zinc-950/80">
  <nav class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-6 px-4 sm:px-6 lg:px-8" aria-label="Primary navigation">
    <a class="shrink-0 text-sm font-semibold tracking-tight" href="/">File Uploader</a>
    <div class="flex min-w-0 items-center gap-2 sm:gap-4">
      <% if (currentUser) { %>
        <span class="hidden max-w-56 truncate text-sm text-zinc-600 sm:block dark:text-zinc-400"><%= currentUser.email %></span>
        <form action="/auth/logout" method="post">
          <input type="hidden" name="_csrf" value="<%= csrfToken() %>" />
          <button class="rounded-md border border-zinc-300 px-3 py-2 text-sm font-medium hover:bg-zinc-100 active:translate-y-px dark:border-zinc-700 dark:hover:bg-zinc-900" type="submit">Sign out</button>
        </form>
      <% } else { %>
        <a class="rounded-md px-3 py-2 text-sm font-medium hover:bg-zinc-100 active:translate-y-px dark:hover:bg-zinc-900" href="/auth/login">Sign in</a>
        <a class="rounded-md bg-zinc-900 px-3 py-2 text-sm font-semibold text-zinc-50 hover:bg-zinc-800 active:translate-y-px dark:bg-zinc-100 dark:text-zinc-900 dark:hover:bg-zinc-200" href="/auth/register">Create account</a>
      <% } %>
    </div>
  </nav>
</header>
