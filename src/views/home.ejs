<!doctype html>
<html lang="en" class="h-full bg-zinc-50 dark:bg-zinc-950">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Organize, upload, and share your files." />
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/app.css" />
  </head>
  <body class="flex min-h-[100dvh] flex-col text-zinc-900 dark:text-zinc-100">
    <%- include('partials/header') %>
    <main class="mx-auto flex w-full max-w-7xl flex-1 items-center px-4 py-16 sm:px-6 lg:px-8">
      <section class="max-w-3xl">
        <% if (currentUser) { %>
          <p class="mb-4 text-sm font-medium text-emerald-700 dark:text-emerald-400">Account ready</p>
          <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">Your private file workspace is ready.</h1>
          <p class="mt-6 max-w-2xl text-lg leading-8 text-zinc-600 dark:text-zinc-400">Folders are ready. Uploads, downloads, and expiring folder shares will be added in the next implementation steps.</p>
          <a class="mt-8 inline-flex rounded-md bg-zinc-900 px-4 py-2.5 text-sm font-semibold text-zinc-50 hover:bg-zinc-800 active:translate-y-px dark:bg-zinc-100 dark:text-zinc-900" href="/folders">Open your folders</a>
        <% } else { %>
          <p class="mb-4 text-sm font-medium text-emerald-700 dark:text-emerald-400">Private by design</p>
          <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">Your files, organized and under your control.</h1>
          <p class="mt-6 max-w-2xl text-lg leading-8 text-zinc-600 dark:text-zinc-400">Create an account to prepare for folder management, secure uploads, and expiring folder shares.</p>
        <% } %>
      </section>
    </main>
    <%- include('partials/footer') %>
  </body>
</html>
