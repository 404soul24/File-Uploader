<!doctype html>
<html lang="en" class="h-full bg-zinc-50 dark:bg-zinc-950">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/app.css" />
  </head>
  <body class="flex min-h-[100dvh] flex-col text-zinc-900 dark:text-zinc-100">
    <%- include('../partials/header') %>
    <main class="mx-auto w-full max-w-4xl flex-1 px-4 py-8 sm:px-6 lg:px-8">
      <nav class="mb-6 flex min-w-0 flex-wrap items-center gap-2 text-sm text-zinc-600 dark:text-zinc-400" aria-label="Breadcrumb">
        <a class="hover:text-zinc-900 hover:underline dark:hover:text-zinc-100" href="/folders">All folders</a>
        <% for (const breadcrumb of breadcrumbs) { %>
          <span aria-hidden="true">/</span>
          <a class="max-w-48 truncate hover:text-zinc-900 hover:underline dark:hover:text-zinc-100" href="/folders/<%= encodeURIComponent(breadcrumb.id) %>"><%= breadcrumb.name %></a>
        <% } %>
        <span aria-hidden="true">/</span>
        <span class="max-w-64 truncate font-medium text-zinc-900 dark:text-zinc-100"><%= file.originalName %></span>
      </nav>
      <section class="rounded-xl border border-zinc-200 bg-white shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
        <div class="border-b border-zinc-200 p-6 sm:p-8 dark:border-zinc-800">
          <p class="text-sm font-medium text-emerald-700 dark:text-emerald-400">File details</p>
          <h1 class="mt-2 break-all text-2xl font-semibold tracking-tight"><%= file.originalName %></h1>
          <a class="mt-6 inline-flex rounded-md bg-zinc-900 px-4 py-2.5 text-sm font-semibold text-zinc-50 hover:bg-zinc-800 active:translate-y-px dark:bg-zinc-100 dark:text-zinc-900" href="<%= file.downloadUrl %>" download>Download</a>
        </div>
        <dl class="grid gap-px bg-zinc-200 sm:grid-cols-2 dark:bg-zinc-800">
          <div class="bg-white p-5 dark:bg-zinc-900">
            <dt class="text-sm text-zinc-600 dark:text-zinc-400">Type</dt>
            <dd class="mt-1 break-all font-medium"><%= file.mimeType %></dd>
          </div>
          <div class="bg-white p-5 dark:bg-zinc-900">
            <dt class="text-sm text-zinc-600 dark:text-zinc-400">Size</dt>
            <dd class="mt-1 font-medium"><%= sizeLabel %></dd>
          </div>
          <div class="bg-white p-5 dark:bg-zinc-900">
            <dt class="text-sm text-zinc-600 dark:text-zinc-400">Uploaded</dt>
            <dd class="mt-1 font-medium"><time datetime="<%= file.uploadedAt.toISOString() %>"><%= file.uploadedAt.toLocaleString() %></time></dd>
          </div>
          <div class="bg-white p-5 dark:bg-zinc-900">
            <dt class="text-sm text-zinc-600 dark:text-zinc-400">Location</dt>
            <dd class="mt-1 font-medium"><%= folder ? folder.name : 'All folders' %></dd>
          </div>
        </dl>
      </section>
    </main>
    <%- include('../partials/footer') %>
  </body>
</html>
