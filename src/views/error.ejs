<!doctype html>
<html lang="en" class="h-full bg-zinc-50 dark:bg-zinc-950">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %> | File Uploader</title>
    <link rel="stylesheet" href="/css/app.css" />
  </head>
  <body class="flex min-h-[100dvh] items-center justify-center px-4 text-zinc-900 dark:text-zinc-100">
    <main class="w-full max-w-lg text-center">
      <p class="text-sm font-semibold text-emerald-700 dark:text-emerald-400"><%= status %></p>
      <h1 class="mt-3 text-3xl font-semibold tracking-tight"><%= title %></h1>
      <p class="mt-4 text-zinc-600 dark:text-zinc-400"><%= message %></p>
      <a class="mt-8 inline-flex rounded-md bg-zinc-900 px-4 py-2 text-sm font-semibold text-zinc-50 active:translate-y-px dark:bg-zinc-100 dark:text-zinc-900" href="/">Return home</a>
    </main>
  </body>
</html>
