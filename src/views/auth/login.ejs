<!doctype html>
<html lang="en" class="h-full bg-zinc-50 dark:bg-zinc-950">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Sign in to File Uploader." />
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/app.css" />
  </head>
  <body class="flex min-h-[100dvh] flex-col text-zinc-900 dark:text-zinc-100">
    <%- include('../partials/header') %>
    <main class="mx-auto flex w-full max-w-md flex-1 items-center px-4 py-12 sm:px-6">
      <section class="w-full rounded-xl border border-zinc-200 bg-white p-6 shadow-sm sm:p-8 dark:border-zinc-800 dark:bg-zinc-900">
        <h1 class="text-2xl font-semibold tracking-tight">Sign in</h1>
        <p class="mt-2 text-sm leading-6 text-zinc-600 dark:text-zinc-400">Access your folders and uploaded files.</p>
        <% if (formError) { %>
          <div class="mt-5 rounded-md border border-red-300 bg-red-50 px-4 py-3 text-sm text-red-800 dark:border-red-900 dark:bg-red-950 dark:text-red-200" role="alert"><%= formError %></div>
        <% } %>
        <form class="mt-6 space-y-5" action="/auth/login" method="post">
          <input type="hidden" name="_csrf" value="<%= csrfToken() %>" />
          <div class="grid gap-2">
            <label class="text-sm font-medium" for="email">Email</label>
            <input class="w-full rounded-md border border-zinc-300 bg-white px-3 py-2.5 text-base outline-none focus:border-emerald-600 focus:ring-2 focus:ring-emerald-600/20 dark:border-zinc-700 dark:bg-zinc-950" id="email" name="email" type="email" value="<%= values.email %>" autocomplete="email" maxlength="320" required aria-invalid="<%= Boolean(fieldErrors.email) %>" aria-describedby="<%= fieldErrors.email ? 'email-error' : '' %>" />
            <% if (fieldErrors.email) { %><p class="text-sm text-red-700 dark:text-red-400" id="email-error"><%= fieldErrors.email %></p><% } %>
          </div>
          <div class="grid gap-2">
            <label class="text-sm font-medium" for="password">Password</label>
            <input class="w-full rounded-md border border-zinc-300 bg-white px-3 py-2.5 text-base outline-none focus:border-emerald-600 focus:ring-2 focus:ring-emerald-600/20 dark:border-zinc-700 dark:bg-zinc-950" id="password" name="password" type="password" autocomplete="current-password" maxlength="128" required aria-invalid="<%= Boolean(fieldErrors.password) %>" aria-describedby="<%= fieldErrors.password ? 'password-error' : '' %>" />
            <% if (fieldErrors.password) { %><p class="text-sm text-red-700 dark:text-red-400" id="password-error"><%= fieldErrors.password %></p><% } %>
          </div>
          <button class="inline-flex w-full items-center justify-center rounded-md bg-zinc-900 px-4 py-2.5 text-sm font-semibold text-zinc-50 hover:bg-zinc-800 active:translate-y-px dark:bg-zinc-100 dark:text-zinc-900 dark:hover:bg-zinc-200" type="submit">Sign in</button>
        </form>
        <p class="mt-6 text-center text-sm text-zinc-600 dark:text-zinc-400">New to File Uploader? <a class="font-semibold text-emerald-700 hover:underline dark:text-emerald-400" href="/auth/register">Create an account</a></p>
      </section>
    </main>
    <%- include('../partials/footer') %>
  </body>
</html>
