<!doctype html>
<html lang="en" class="h-full bg-zinc-50 dark:bg-zinc-950">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Manage your private folders." />
    <title><%= title %> | File Uploader</title>
    <link rel="stylesheet" href="/css/app.css" />
  </head>
  <body class="flex min-h-[100dvh] flex-col text-zinc-900 dark:text-zinc-100">
    <%- include('../partials/header') %>
    <main class="mx-auto w-full max-w-7xl flex-1 px-4 py-8 sm:px-6 lg:px-8">
      <nav class="mb-6 flex min-w-0 flex-wrap items-center gap-2 text-sm text-zinc-600 dark:text-zinc-400" aria-label="Breadcrumb">
        <a class="hover:text-zinc-900 hover:underline dark:hover:text-zinc-100" href="/folders">All folders</a>
        <% for (const breadcrumb of breadcrumbs) { %>
          <span aria-hidden="true">/</span>
          <a class="max-w-48 truncate hover:text-zinc-900 hover:underline dark:hover:text-zinc-100" href="/folders/<%= encodeURIComponent(breadcrumb.id) %>"><%= breadcrumb.name %></a>
        <% } %>
      </nav>
      <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_20rem]">
        <div class="min-w-0 space-y-8">
          <section>
            <div class="flex flex-wrap items-start justify-between gap-4">
              <div>
                <h1 class="text-3xl font-semibold tracking-tight"><%= folder ? folder.name : 'Your folders' %></h1>
                <% if (folder) { %>
                  <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-400">Opened <time datetime="<%= folder.updatedAt.toISOString() %>"><%= folder.updatedAt.toLocaleString() %></time></p>
                <% } else { %>
                  <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-400"><%= childFolders.length %> top-level <%= childFolders.length === 1 ? 'folder' : 'folders' %></p>
                <% } %>
              </div>
              <% if (folder) { %>
                <a class="rounded-md border border-red-300 px-3 py-2 text-sm font-medium text-red-700 hover:bg-red-50 active:translate-y-px dark:border-red-900 dark:text-red-300 dark:hover:bg-red-950" href="/folders/<%= encodeURIComponent(folder.id) %>/delete">Delete folder</a>
              <% } %>
            </div>
            <% if (folder) { %>
              <form class="mt-6 flex flex-wrap items-end gap-3 border-y border-zinc-200 py-5 dark:border-zinc-800" action="/folders/<%= encodeURIComponent(folder.id) %>/rename" method="post">
                <input type="hidden" name="_csrf" value="<%= csrfToken() %>" />
                <div class="grid min-w-56 flex-1 gap-2">
                  <label class="text-sm font-medium" for="folder-name">Folder name</label>
                  <input class="w-full rounded-md border border-zinc-300 bg-white px-3 py-2 outline-none focus:border-emerald-600 focus:ring-2 focus:ring-emerald-600/20 dark:border-zinc-700 dark:bg-zinc-950" id="folder-name" name="name" value="<%= folder.name %>" maxlength="120" required />
                </div>
                <button class="rounded-md border border-zinc-300 px-4 py-2 text-sm font-semibold hover:bg-zinc-100 active:translate-y-px dark:border-zinc-700 dark:hover:bg-zinc-900" type="submit">Save name</button>
              </form>
            <% } %>
          </section>
          <section aria-labelledby="subfolders-heading">
            <h2 class="text-lg font-semibold" id="subfolders-heading">Subfolders</h2>
            <% if (childFolders.length > 0) { %>
              <ul class="mt-4 grid gap-3 sm:grid-cols-2">
                <% for (const child of childFolders) { %>
                  <li class="rounded-lg border border-zinc-200 bg-white p-4 dark:border-zinc-800 dark:bg-zinc-900">
                    <a class="font-medium hover:underline" href="/folders/<%= encodeURIComponent(child.id) %>"><%= child.name %></a>
                    <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400">Updated <time datetime="<%= child.updatedAt.toISOString() %>"><%= child.updatedAt.toLocaleString() %></time></p>
                  </li>
                <% } %>
              </ul>
            <% } else { %>
              <div class="mt-4 rounded-lg border border-dashed border-zinc-300 p-8 text-center dark:border-zinc-700">
                <h3 class="font-medium">No subfolders yet</h3>
                <p class="mt-1 text-sm text-zinc-600 dark:text-zinc-400">Create a folder to keep related files together.</p>
              </div>
            <% } %>
          </section>
          <section aria-labelledby="files-heading">
            <h2 class="text-lg font-semibold" id="files-heading">Files</h2>
            <% if (files.length > 0) { %>
              <ul class="mt-4 divide-y divide-zinc-200 rounded-lg border border-zinc-200 bg-white dark:divide-zinc-800 dark:border-zinc-800 dark:bg-zinc-900">
                <% for (const file of files) { %>
                  <li class="flex flex-wrap items-center gap-4 p-4 sm:flex-nowrap">
                    <div class="min-w-0 flex-1">
                      <a class="block truncate font-medium hover:underline" href="/files/<%= encodeURIComponent(file.id) %>"><%= file.originalName %></a>
                      <p class="mt-1 truncate text-xs text-zinc-500 dark:text-zinc-400"><%= file.mimeType %> · <%= file.sizeLabel %> · <time datetime="<%= file.uploadedAt.toISOString() %>"><%= file.uploadedAt.toLocaleString() %></time></p>
                    </div>
                    <a class="rounded-md border border-zinc-300 px-3 py-2 text-sm font-medium hover:bg-zinc-100 active:translate-y-px dark:border-zinc-700 dark:hover:bg-zinc-800" href="<%= file.downloadUrl %>" download>Download</a>
                  </li>
                <% } %>
              </ul>
            <% } else { %>
              <div class="mt-4 rounded-lg border border-dashed border-zinc-300 p-8 text-center dark:border-zinc-700">
                <h3 class="font-medium">No files yet</h3>
                <p class="mt-1 text-sm text-zinc-600 dark:text-zinc-400">Uploads will appear here once enabled.</p>
              </div>
            <% } %>
          </section>
        </div>
        <aside class="h-fit rounded-xl border border-zinc-200 bg-white p-5 dark:border-zinc-800 dark:bg-zinc-900">
          <h2 class="font-semibold">New subfolder</h2>
          <form class="mt-4 grid gap-3" action="/folders" method="post">
            <input type="hidden" name="_csrf" value="<%= csrfToken() %>" />
            <input type="hidden" name="parentId" value="<%= folder ? folder.id : '' %>" />
            <div class="grid gap-2">
              <label class="text-sm font-medium" for="new-folder-name">Name</label>
              <input class="w-full rounded-md border border-zinc-300 bg-white px-3 py-2 outline-none focus:border-emerald-600 focus:ring-2 focus:ring-emerald-600/20 dark:border-zinc-700 dark:bg-zinc-950" id="new-folder-name" name="name" maxlength="120" required />
            </div>
            <button class="rounded-md bg-zinc-900 px-4 py-2 text-sm font-semibold text-zinc-50 hover:bg-zinc-800 active:translate-y-px dark:bg-zinc-100 dark:text-zinc-900" type="submit">Create folder</button>
          </form>
        </aside>
      </div>
    </main>
    <%- include('../partials/footer') %>
  </body>
</html>
