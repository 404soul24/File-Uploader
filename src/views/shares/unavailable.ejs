<!doctype html>
<html lang="en" class="h-full bg-zinc-50 dark:bg-zinc-950">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="referrer" content="no-referrer" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/app.css" />
  </head>
  <body class="flex min-h-[100dvh] items-center justify-center px-4 text-zinc-900 dark:text-zinc-100">
    <main class="w-full max-w-lg text-center">
      <p class="text-sm font-semibold text-amber-700 dark:text-amber-400">404</p>
      <h1 class="mt-3 text-3xl font-semibold tracking-tight">Share unavailable</h1>
      <p class="mt-4 text-zinc-600 dark:text-zinc-400">This link is invalid, expired, revoked, or the content is no longer available.</p>
    </main>
  </body>
</html>
