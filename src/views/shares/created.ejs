<!doctype html>
<html lang="en" class="h-full bg-zinc-50 dark:bg-zinc-950">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/app.css" />
  </head>
  <body class="flex min-h-[100dvh] flex-col text-zinc-900 dark:text-zinc-100">
    <%- include('../partials/header') %>
    <main class="mx-auto w-full max-w-2xl flex-1 px-4 py-12 sm:px-6">
      <section class="rounded-xl border border-zinc-200 bg-white p-6 shadow-sm sm:p-8 dark:border-zinc-800 dark:bg-zinc-900">
        <p class="text-sm font-medium text-emerald-700 dark:text-emerald-400">Share link created</p>
        <h1 class="mt-2 text-2xl font-semibold tracking-tight">Anyone with this link can access the folder until it expires.</h1>
        <div class="mt-6 grid gap-2">
          <label class="text-sm font-medium" for="share-url">Share link</label>
          <input class="w-full rounded-md border border-zinc-300 bg-zinc-50 px-3 py-2 font-mono text-sm dark:border-zinc-700 dark:bg-zinc-950" id="share-url" value="<%= url %>" readonly />
          <p class="text-sm text-zinc-600 dark:text-zinc-400">Copy this link now. For security, it cannot be shown again.</p>
        </div>
        <dl class="mt-6 grid gap-4 border-t border-zinc-200 pt-6 sm:grid-cols-2 dark:border-zinc-800">
          <div>
            <dt class="text-sm text-zinc-600 dark:text-zinc-400">Expires</dt>
            <dd class="mt-1 font-medium"><time datetime="<%= share.expiresAt.toISOString() %>"><%= share.expiresAt.toLocaleString() %></time></dd>
          </div>
          <div>
            <dt class="text-sm text-zinc-600 dark:text-zinc-400">Duration</dt>
            <dd class="mt-1 font-medium"><%= share.durationDays %> days</dd>
          </div>
        </dl>
        <div class="mt-8 flex flex-wrap gap-3">
          <a class="rounded-md bg-zinc-900 px-4 py-2 text-sm font-semibold text-zinc-50 hover:bg-zinc-800 active:translate-y-px dark:bg-zinc-100 dark:text-zinc-900" href="/shares">Manage shares</a>
          <a class="rounded-md border border-zinc-300 px-4 py-2 text-sm font-semibold hover:bg-zinc-100 active:translate-y-px dark:border-zinc-700 dark:hover:bg-zinc-900" href="/folders">Back to folders</a>
        </div>
      </section>
    </main>
    <%- include('../partials/footer') %>
  </body>
</html>
