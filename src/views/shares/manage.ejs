<!doctype html>
<html lang="en" class="h-full bg-zinc-50 dark:bg-zinc-950">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/app.css" />
  </head>
  <body class="flex min-h-[100dvh] flex-col text-zinc-900 dark:text-zinc-100">
    <%- include('../partials/header') %>
    <main class="mx-auto w-full max-w-5xl flex-1 px-4 py-8 sm:px-6 lg:px-8">
      <h1 class="text-3xl font-semibold tracking-tight">Shared folders</h1>
      <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-400">Share links are shown once when created. Create a new link if one is lost.</p>
      <% if (shares.length > 0) { %>
        <ul class="mt-8 divide-y divide-zinc-200 rounded-lg border border-zinc-200 bg-white dark:divide-zinc-800 dark:border-zinc-800 dark:bg-zinc-900">
          <% for (const share of shares) { %>
            <li class="flex flex-wrap items-center gap-4 p-5">
              <div class="min-w-56 flex-1">
                <a class="font-medium hover:underline" href="/folders/<%= encodeURIComponent(share.folder.id) %>"><%= share.folder.name %></a>
                <p class="mt-1 text-sm text-zinc-600 dark:text-zinc-400">
                  <% if (share.revokedAt) { %>Revoked <%= share.revokedAt.toLocaleString() %><% } else if (share.isActive) { %>Active until <time datetime="<%= share.expiresAt.toISOString() %>"><%= share.expiresAt.toLocaleString() %></time><% } else { %>Expired <%= share.expiresAt.toLocaleString() %><% } %>
                </p>
              </div>
              <span class="rounded-full px-2.5 py-1 text-xs font-semibold <%= share.isActive ? 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300' : 'bg-zinc-200 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300' %>"><%= share.isActive ? 'Active' : 'Inactive' %></span>
              <% if (share.isActive) { %>
                <form action="/shares/<%= encodeURIComponent(share.id) %>/revoke" method="post">
                  <input type="hidden" name="_csrf" value="<%= csrfToken() %>" />
                  <button class="rounded-md border border-red-300 px-3 py-2 text-sm font-medium text-red-700 hover:bg-red-50 active:translate-y-px dark:border-red-900 dark:text-red-300 dark:hover:bg-red-950" type="submit">Revoke</button>
                </form>
              <% } %>
            </li>
          <% } %>
        </ul>
      <% } else { %>
        <div class="mt-8 rounded-lg border border-dashed border-zinc-300 p-10 text-center dark:border-zinc-700">
          <h2 class="font-medium">No shared folders</h2>
          <p class="mt-1 text-sm text-zinc-600 dark:text-zinc-400">Open a folder and choose Share this folder to create a link.</p>
        </div>
      <% } %>
    </main>
    <%- include('../partials/footer') %>
  </body>
</html>
