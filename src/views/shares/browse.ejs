<!doctype html>
<html lang="en" class="h-full bg-zinc-50 dark:bg-zinc-950">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="referrer" content="no-referrer" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/app.css" />
  </head>
  <body class="flex min-h-[100dvh] flex-col text-zinc-900 dark:text-zinc-100">
    <header class="border-b border-zinc-200 dark:border-zinc-800">
      <div class="mx-auto flex h-16 max-w-5xl items-center justify-between gap-4 px-4 sm:px-6">
        <span class="text-sm font-semibold">Shared files</span>
        <span class="rounded-full bg-emerald-100 px-3 py-1 text-xs font-semibold text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300">Read only</span>
      </div>
    </header>
    <main class="mx-auto w-full max-w-5xl flex-1 px-4 py-8 sm:px-6">
      <nav class="mb-6 flex min-w-0 flex-wrap items-center gap-2 text-sm text-zinc-600 dark:text-zinc-400" aria-label="Breadcrumb">
        <% breadcrumbs.forEach((breadcrumb, index) => { %>
          <% if (index === breadcrumbs.length - 1) { %>
            <span class="max-w-56 truncate font-medium text-zinc-900 dark:text-zinc-100"><%= breadcrumb.name %></span>
          <% } else { %>
            <a class="max-w-48 truncate hover:text-zinc-900 hover:underline dark:hover:text-zinc-100" href="/share/<%= encodeURIComponent(token) %>/folders/<%= encodeURIComponent(breadcrumb.id) %>"><%= breadcrumb.name %></a>
            <span aria-hidden="true">/</span>
          <% } %>
        <% }); %>
      </nav>
      <div class="flex flex-wrap items-end justify-between gap-3">
        <h1 class="break-words text-3xl font-semibold tracking-tight"><%= folder.name %></h1>
        <p class="text-sm text-zinc-600 dark:text-zinc-400">Link expires <time datetime="<%= share.expiresAt.toISOString() %>"><%= share.expiresAt.toLocaleString() %></time></p>
      </div>
      <div class="mt-8 grid gap-8 md:grid-cols-2">
        <section aria-labelledby="shared-folders">
          <h2 class="text-lg font-semibold" id="shared-folders">Folders</h2>
          <% if (childFolders.length > 0) { %>
            <ul class="mt-4 divide-y divide-zinc-200 rounded-lg border border-zinc-200 bg-white dark:divide-zinc-800 dark:border-zinc-800 dark:bg-zinc-900">
              <% for (const child of childFolders) { %>
                <li class="p-4"><a class="font-medium hover:underline" href="/share/<%= encodeURIComponent(token) %>/folders/<%= encodeURIComponent(child.id) %>"><%= child.name %></a></li>
              <% } %>
            </ul>
          <% } else { %>
            <p class="mt-4 rounded-lg border border-dashed border-zinc-300 p-6 text-sm text-zinc-600 dark:border-zinc-700 dark:text-zinc-400">No shared subfolders.</p>
          <% } %>
        </section>
        <section aria-labelledby="shared-files">
          <h2 class="text-lg font-semibold" id="shared-files">Files</h2>
          <% if (files.length > 0) { %>
            <ul class="mt-4 divide-y divide-zinc-200 rounded-lg border border-zinc-200 bg-white dark:divide-zinc-800 dark:border-zinc-800 dark:bg-zinc-900">
              <% for (const file of files) { %>
                <li class="flex items-center gap-3 p-4">
                  <div class="min-w-0 flex-1">
                    <p class="truncate font-medium"><%= file.originalName %></p>
                    <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400"><%= file.mimeType %> · <%= file.sizeLabel %></p>
                  </div>
                  <a class="rounded-md border border-zinc-300 px-3 py-2 text-sm font-medium hover:bg-zinc-100 active:translate-y-px dark:border-zinc-700 dark:hover:bg-zinc-800" href="/share/<%= encodeURIComponent(token) %>/files/<%= encodeURIComponent(file.id) %>/download" download>Download</a>
                </li>
              <% } %>
            </ul>
          <% } else { %>
            <p class="mt-4 rounded-lg border border-dashed border-zinc-300 p-6 text-sm text-zinc-600 dark:border-zinc-700 dark:text-zinc-400">No shared files.</p>
          <% } %>
        </section>
      </div>
    </main>
    <footer class="border-t border-zinc-200 py-6 text-center text-sm text-zinc-500 dark:border-zinc-800 dark:text-zinc-400">Shared read-only content</footer>
  </body>
</html>
